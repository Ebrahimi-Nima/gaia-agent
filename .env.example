# Copy to .env and fill in. Do not use quotes around values (Docker's --env-file keeps them literally).
# .env is git-ignored: never commit it.

# At least one LLM provider key is required. Keys of one Groq account share one quota.
GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Recommended: last fallback when Groq is rate limited (free models, check the catalog for current IDs).
OPENROUTER_API_KEY_1=

# Only for the GAIA course questions (not needed for `ask`):
HF_TOKEN=           # read token; accept the terms of the gated gaia-benchmark/GAIA dataset first
HF_USERNAME=        # your Hugging Face username (used by `submit`)
EMAIL=              # contact address placed in the Wikipedia User-Agent

# Optional model overrides (LiteLLM model IDs; provider catalogs change often)
# GROQ_MODEL=groq/openai/gpt-oss-120b
# GROQ_MODEL_2=groq/openai/gpt-oss-20b
# OPENROUTER_MODEL=
# VISION_MODEL=            # enables the describe_image tool
# WHISPER_MODEL=small
# GAIA_DATA_DIR=data
